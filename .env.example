# 🌐 Environment Configuration Template
# Copy this file to .env and fill in the values

# --- AWS Configuration (Reporting) ---
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# --- Jira Integration (Sentinel Engineering) ---
# Your Jira Cloud URL (e.g., https://your-domain.atlassian.net)
JIRA_URL=
# The email you use to log in to Jira
JIRA_USER_EMAIL=
# Your Atlassian API Token (Generated at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=

# --- Test Execution ---
ENV=staging
BROWSER=chrome
HEADLESS=true
